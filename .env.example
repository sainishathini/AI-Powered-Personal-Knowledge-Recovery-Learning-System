# MemoryMap Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Optional: In-memory store used if blank)
MONGODB_URI=

# AI Credentials (Optional: Built-in Heuristic Engine used if blank)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google Drive OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# MemoryMap Environment Configuration

# Express Server Port
PORT=5000

# MongoDB URI (Optional: Leave blank to run in robust local/in-memory mode)
MONGODB_URI=

# Optional LLM API Key (Gemini or OpenAI API key). 
# If not provided, MemoryMap uses its built-in Heuristic AI Engine automatically!
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google Drive OAuth 2.0 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI should match your application callback (e.g., http://localhost:3000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# MemoryMap Environment Configuration

# Express Server Port
PORT=5000

# MongoDB URI (Optional: Leave blank to run in robust local/in-memory mode)
MONGODB_URI=

# Optional LLM API Key (Gemini or OpenAI API key). 
# If not provided, MemoryMap uses its built-in Heuristic AI Engine automatically!
GEMINI_API_KEY=
OPENAI_API_KEY=
